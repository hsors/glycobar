# Production environment for the GlycoBAR site.
#
# The full contents of this file (with real values) go into the Gitea Actions
# secret GLYCOBAR_SECRET; the deploy workflow writes it to
# /home/edwins/xyz/server/glycobar-app/.env on the host before running compose.
#
# The site is static — DOMAIN is only consumed by docker-compose.yml to build
# the Traefik Host() rules. Nothing here reaches the browser.

DOMAIN=glycobar.ironhandscapital.com
